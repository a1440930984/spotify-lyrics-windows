<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>SpotifyLyricsWin</AssemblyName>
    <RootNamespace>SpotifyLyricsWin</RootNamespace>
    <Version>0.8.6</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- v0.4：WMI Win32_Process.Create 脱钩拉起更新助手（System.Management 官方包）；
       拉起失败还有 PowerShell/CIM 兜底（Core/UpdateLauncher） -->
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- v0.6：Fluent 界面库（lepoco WPF-UI 4.3.0）——设置窗/手动选词窗换 FluentWindow
         与库控件；悬浮窗/托盘不动。注意包 ID 是 WPF-UI（带连字符），nuget 上另有同名
         无关包 WPF.UI（XIAMU/net451），别装错。 -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- 图标同时随输出复制一份到根目录（Link 决定输出相对路径）：
       托盘与各窗口在运行时从 exe 目录加载同一份 app.ico -->
  <ItemGroup>
    <Content Include="Assets\app.ico" Link="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\app.png" Link="app.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- WinForms 的隐式全局 using 会与 WPF 的 Application/Color 等类型冲突；
       托盘文件 (Ui/Tray.cs) 自带显式 using，不受影响 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Drawing.Drawing2D" />
  </ItemGroup>

</Project>
